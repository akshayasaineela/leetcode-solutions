class Solution {
    public int minEatingSpeed(int[] piles, int h) {
        int min = 1;
        int max = piles[0];
        for(int i = 0; i < piles.length; i++){
            if(piles[i] > max){
                max = piles[i];
            }
        }
        while(min < max){
            int mid = (min + max) / 2;
            int res = 0;
            for(int i = 0; i < piles.length; i++){
                res += (piles[i] + mid - 1) / mid;
            }
            if(res <= h){
                max = mid;
            }else{
                min = mid + 1;
            }
        }
        return min;
    }
}
