class Solution {
    public int[] relativeSortArray(int[] arr1, int[] arr2) {
        int[] res = new int[arr1.length];
        int k = 0;
        for(int i = 0; i < arr2.length; i++){
            for(int j = 0; j < arr1.length; j++){
                if(arr1[j] == arr2[i]){
                    res[k++] = arr1[j];
                }
            }
        }
        int[] remaining = new int[arr1.length];
        int r = 0;
        for(int i = 0; i < arr1.length; i++){
            boolean found = false;
            for(int j = 0; j < arr2.length; j++){
                if(arr1[i] == arr2[j]){
                    found = true;
                    break;
                }
            }
            if(!found){
                remaining[r++] = arr1[i];
            }
        }
        for(int i = 1; i < r; i++){
            int key = remaining[i];
            int j = i - 1;

            while(j >= 0 && remaining[j] > key){
                remaining[j + 1] = remaining[j];
                j--;
            }
            remaining[j + 1] = key;
        }
        for(int i = 0; i < r; i++){
            res[k++] = remaining[i];
        }
        return res;
    }
}
